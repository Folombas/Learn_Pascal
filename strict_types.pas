program strict_types;

{
	Демонстраци строгой типизации в Паскале.
	
	Паскаль НЕ разрешает неявные преобразования между несовместимыми
	типами. Если нужно смешать integer и real или число и строку —
	программист обязан явно указать, что он имел в виду.

	Ниже — рабочие примеры. А в комментариях — то, что компилятор
	отказался бы собирать.
}

var
	i: integer;
	r: real;
	s: string;
	c: char;
	
begin
	{ --- 1. integer и real --- }
	i := 7;
	r := 2.5;
	
	{ Нельзя: r := i + r;  -- ошибка: смешение типов без преобразования }
	{ Нельзя: i := r;      -- ошибка: real нельзя присвоить integer }
	
	  r := i + r;          { это допустимо: integer автоматически widening до real }
  writeln('r = i + r = ', r:0:2);   { 9.50 }

  i := Trunc(r);       { явное преобразование real -> integer (отбрасывает дробную часть) }
  writeln('i = Trunc(r) = ', i);    { 9 }

  i := Round(r);       { явное преобразование с округлением }
  writeln('i = Round(r) = ', i);    { 10 }
	
{ --- 2. число и строка --- }
  i := 42;

  { Нельзя: s := i;      -- ошибка: integer нельзя присвоить string }
  { Нельзя: i := s;      -- ошибка: string нельзя присвоить integer }

  s := IntToStr(i);    { явное преобразование integer -> string }
  writeln('s = IntToStr(i) = ', s);       { '42' }

  i := StrToInt(s);    { явное преобразование string -> integer }
  writeln('i = StrToInt(s) = ', i + 1);   { 43 }

  { --- 3. символ и строка --- }
  c := 'A';

  { Нельзя: s := c;      -- ошибка: char и string — разные типы }
  { Нельзя: c := s;      -- ошибка }

  s := c;              { char -> string допустимо (расширение) }
  writeln('s = c = ', s);                 { 'A' }

  c := s[1];           { string -> char через индексацию }
  writeln('c = s[1] = ', c);              { 'A' }

  { --- 4. целое и дробное в writeln --- }
  i := 5;
  r := 5;

  { writeln(i / 2); }   { оператор / всегда даёт real, это нормально }
  writeln('i / 2 = ', i / 2 : 0 : 2);     { 2.50 }
  writeln('i div 2 = ', i div 2);         { 2 — целочисленное деление }
  writeln('i mod 2 = ', i mod 2);         { 1 — остаток }

  { А вот так — нельзя, нужен явный Round/Trunc: }
  { i := i / 2; }       { ошибка: real нельзя присвоить integer }
  i := i div 2;        { правильно: целочисленное деление }
  writeln('i = i div 2 = ', i);           { 2 }
end.	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
