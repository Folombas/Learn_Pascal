program subranges;

{
	Демонстрация (subrange types) в Паскале.
	
	Поддиапозон - это тип, значения которого ограничены некоторым интервалом бащового типа.
	Компилятор и среда выполнения (при включённой проверке {$R+}) следят, чтобы значение
	не выходило за границы.
	
	Синтаксиc: type Имя = НижняяГраница..ВерхняяГраница;
}

{$R+}   { включаем проверку диапазонов: выход за границы → ошибка во время выполнения }

type
 TMonth = 1..12; { номер месяца }
 TDay = 1..31;	 { день месяца }
 TDigit = '0'..'9'; { десятичная цифра }
 TLetter = 'A'..'Z' { заглавная латинская буква
 TScore = 0..100;	{ школьная оценка в баллах }
 
 var
	m: TMonth;
	d: TDay;
	c: TDigit;
	ch: TLetter;
	score: TScore;
	i: integer;
	
begin
	{ --- 1. Присваивание допустимых значений --- }
	m := 7;
	d := 15;
	c := '5';
	ch :=  'K';
	score := 87;
	
	writeln('Месяц: ', m);
  writeln('День:  ', d);
  writeln('Цифра: ', c);
  writeln('Буква: ', ch);
  writeln('Балл:  ', score);
  writeln;
 
 
  { --- 2. Проверка принадлежности диапазону --- }
  if m in [1..6] then
    writeln('Месяц ', m, ' — первое полугодие')
  else
    writeln('Месяц ', m, ' — второе полугодие');

  if c in ['0'..'4'] then
    writeln('Цифра ', c, ' — младшая половина')
  else
    writeln('Цифра ', c, ' — старшая половина');

  writeln;
  
  
  { --- 3. Обход всех значений поддиапазона --- }
  write('Все месяцы: ');
  for m := 1 to 12 do
    write(m, ' ');
  writeln;
  writeln;
 
 
 { --- 4. Сумма по поддиапазону --- }
  score := 0;
  for i := 1 to 5 do
    score := score + 20;    { 20, 40, 60, 80, 100 — всё в диапазоне 0..100 }
  writeln('Суммарный балл: ', score);   { 100 }
  
  
  { --- 5. Что было бы при выходе за границы --- }
  { Если раскомментировать строки ниже — программа упадёт
    с ошибкой Range check error (при {$R+}).

    m := 13;      { 13 не входит в 1..12 }
    d := 0;       { 0 не входит в 1..31 }
    c := 'x';     { строчная буква не входит в '0'..'9' }
    score := 150; { 150 не входит в 0..100 }
  }

  writeln;
  writeln('Программа завершилась без ошибок диапазона.');
end.
 
 
 
 
 
 
 
 
 
 
 
 
