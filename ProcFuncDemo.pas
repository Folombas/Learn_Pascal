program ProcFuncDemo;

var
	a, b, result: integer;
	
// ============================================
// ПРОЦЕДУРА — не возвращает значение
// ============================================

proceduree ShowSum(x, y: integer);
var
	sum: integer;
begin
	sum := x + y;
	writeln(' [Процедура ShowSum] Сумма ', x, ' + ', y, ' = ', sum);
	  // Здесь нет присваивания имени процедуры — она ничего не возвращает
end;
	
	
// ============================================
// ПРОЦЕДУРА с параметром-переменной (var)
// изменяет значение переданной переменной
// ============================================
procedure DoubleValue(var x: integer);
begin
  x := x * 2;
  writeln('  [Процедура DoubleValue] Значение внутри процедуры = ', x);
end;

// ============================================
// ФУНКЦИЯ — возвращает значение через своё имя
// ============================================
function GetSum(x, y: integer): integer;
begin
	GetSum := x + y; // результат присваивается имени функции
end;

// ============================================
// ФУНКЦИЯ — возвращает максимальное из двух чисел
// ============================================
function MaxOf(x, y: integer): integer;
begin
  if x > y then
    MaxOf := x
  else
    MaxOf := y;
end;


// ============================================
// ФУНКЦИЯ — возвращает логическое значение
// ============================================
function IsEven(x: integer): boolean;
begin
  IsEven := (x mod 2 = 0);
end;


// ============================================
// Главная программа
// ============================================
begin
  writeln('============================================');
  writeln('  Разница между процедурами и функциями');
  writeln('============================================');
  writeln;

  a := 7;
  b := 12;

  writeln('Исходные значения: a = ', a, ', b = ', b);
  writeln;

  // --- Процедура: просто выполняет действие, ничего не возвращает ---
  writeln('1) ВЫЗОВ ПРОЦЕДУРЫ (не возвращает значение):');
  ShowSum(a, b);
  writeln;

  // --- Процедура с var: изменяет саму переменную ---
  writeln('2) ПРОЦЕДУРА С ПАРАМЕТРОМ VAR (изменяет переменную):');
  writeln('  До вызова: a = ', a);
  DoubleValue(a);
  writeln('  После вызова: a = ', a);
  writeln;

  // --- Функция: возвращает значение, можно присвоить переменной ---
  writeln('3) ВЫЗОВ ФУНКЦИИ (возвращает значение):');
  result := GetSum(a, b);
  writeln('  [Функция GetSum] result = ', result);
  writeln;

  // --- Функция прямо в выражении ---
  writeln('4) ФУНКЦИЯ В ВЫРАЖЕНИИ:');
  writeln('  GetSum(a, b) * 2 = ', GetSum(a, b) * 2);
  writeln;

  // --- Функция MaxOf ---
  writeln('5) ФУНКЦИЯ MaxOf:');
  writeln('  Максимум из ', a, ' и ', b, ' = ', MaxOf(a, b));
  writeln;

  // --- Функция IsEven в условии ---
  writeln('6) ФУНКЦИЯ IsEven В УСЛОВИИ:');
  if IsEven(a) then
    writeln('  Число ', a, ' — чётное')
  else
    writeln('  Число ', a, ' — нечётное');
  writeln;

  writeln('============================================');
  writeln('  ВЫВОД:');
  writeln('  • Процедура выполняет действие, но НЕ возвращает значение.');
  writeln('  • Функция ВОЗВРАЩАЕТ значение через своё имя.');
  writeln('  • Функцию можно использовать в выражениях и условиях.');
  writeln('  • Процедуру — только как отдельный оператор.');
  writeln('============================================');
end.


















