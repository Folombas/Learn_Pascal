program records;

{
  Демонстрация записей (record) и вариантных записей (variant record)
  в Паскале.

  Обычная запись объединяет разнотипные поля под одним именем —
  это база для структур данных (точка, дата, студент, товар...).

  Вариантная запись позволяет хранить в одной и той же памяти
  разные наборы полей в зависимости от значения поля-тега.
  Это аналог union в C, но с контролем со стороны языка.
}

type
  { --- Обычная запись: точка на плоскости --- }
  TPoint = record
    X: real;
    Y: real;
  end;

  { --- Обычная запись: дата --- }
  TDate = record
    Day:   1..31;
    Month: 1..12;
    Year:  1900..2100;
  end;

  { --- Обычная запись: студент --- }
  TStudent = record
    Name:   string[40];
    Age:    byte;
    Avg:    real;
  end;

  { --- Вариантная запись: геометрическая фигура --- }
  TFigureKind = (fkCircle, fkRect, fkTriangle);

  TFigure = record
    Kind: TFigureKind;
    case TFigureKind of
      fkCircle:   (Radius: real);
      fkRect:     (Width, Height: real);
      fkTriangle: (A, B, C: real);
  end;

var
  p: TPoint;
  d: TDate;
  st: TStudent;
  f: TFigure;

begin
  { ================================================================
     ЧАСТЬ 1. Обычная запись
    ================================================================ }

  { --- 1. Присваивание полей --- }
  p.X := 3.0;
  p.Y := 4.0;
  writeln('Точка: (', p.X:0:1, ', ', p.Y:0:1, ')');
  writeln('Расстояние от начала координат: ',
          Sqrt(p.X*p.X + p.Y*p.Y):0:2);
  writeln;

  { --- 2. Оператор with: сокращает доступ к полям --- }
  with d do
  begin
    Day := 15;
    Month := 9;
    Year := 2026;
  end;
  writeln('Дата: ', d.Day, '.', d.Month, '.', d.Year);
  writeln;

  { --- 3. Копирование записей целиком --- }
  st.Name := 'Иван Петров';
  st.Age := 19;
  st.Avg := 4.5;

  writeln('Студент: ', st.Name);
  writeln('Возраст: ', st.Age);
  writeln('Средний балл: ', st.Avg:0:1);
  writeln;

  { --- 4. Массив записей --- }
  { здесь покажем просто идею: массив студентов — это тип array[1..N] of TStudent }

  { ================================================================
     ЧАСТЬ 2. Вариантная запись
    ================================================================ }

  { --- 5. Фигура-круг --- }
  f.Kind := fkCircle;
  f.Radius := 5.0;
  writeln('Фигура: круг, R = ', f.Radius:0:1,
          ', площадь = ', (Pi * f.Radius * f.Radius):0:2);
  writeln;

  { --- 6. Та же переменная, но теперь прямоугольник --- }
  f.Kind := fkRect;
  f.Width := 4.0;
  f.Height := 6.0;
  writeln('Фигура: прямоугольник ',
          f.Width:0:1, ' x ', f.Height:0:1,
          ', площадь = ', (f.Width * f.Height):0:2);
  writeln;

  { --- 7. И снова та же переменная — треугольник --- }
  f.Kind := fkTriangle;
  f.A := 3.0;
  f.B := 4.0;
  f.C := 5.0;
  { площадь по формуле Герона }
  writeln('Фигура: треугольник со сторонами ',
          f.A:0:1, ', ', f.B:0:1, ', ', f.C:0:1);
  writeln;

  { --- 8. Разбор через case по тегу --- }
  writeln('Разбор фигуры через case:');
  case f.Kind of
    fkCircle:
      writeln('  Круг радиуса ', f.Radius:0:1);
    fkRect:
      writeln('  Прямоугольник ', f.Width:0:1, ' x ', f.Height:0:1);
    fkTriangle:
      writeln('  Треугольник ', f.A:0:1, ', ', f.B:0:1, ', ', f.C:0:1);
  end;
  writeln;

  { --- 9. Что язык НЕ позволит --- }
  { Если f.Kind = fkCircle, то f.Width уже не имеет смысла.
    Компилятор языка сам не проверяет это во время выполнения,
    но структура кода и поле-тег Kind помогают программисту
    всегда знать, какие поля сейчас "живые".
    Попытка прочитать f.Width при f.Kind = fkCircle — логическая
    ошибка, а не ошибка компиляции. }

  writeln('Программа завершилась.');
end.

