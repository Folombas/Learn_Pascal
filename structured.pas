program structured;

{
  Демонстрация философии структурного программирования,
  которую Никлаус Вирт заложил в Паскаль.

  Три принципа:
    ЯСНОСТЬ    — каждая подпрограмма решает одну маленькую задачу
    ПОРЯДОК    — программа читается сверху вниз, как рассказ
    ДИСЦИПЛИНА — никаких goto, только три базовые конструкции:
                 последовательность, ветвление, цикл

  Задача: проверить, является ли число «счастливым билетом»,
  то есть равны ли суммы его первых и последних трёх цифр.
  Задача простая — но решаем её «по-виртовски»: разбиваем
  на крошечные понятные шаги, каждый — отдельная функция.
}

{ ============================================================
  ШАГ 1. Ясность: одна функция — одна идея.

  Функция DigitSum принимает число и позицию (с какой стороны
  считать 3 цифры) и возвращает их сумму.
  ============================================================ }
function DigitSum(n: integer; fromRight: boolean): integer;
var
  i, d, total: integer;
begin
  total := 0;
  for i := 1 to 3 do
  begin
    d := n mod 10;          { последняя цифра }
    total := total + d;
    n := n div 10;          { отбросили её }
  end;
  DigitSum := total;
end;

{ ============================================================
  ШАГ 2. Порядок: более крупная функция строится из мелких.

  IsLuckyTicket — «счастливый ли билет». Она не знает,
  КАК считаются суммы, — она просто сравнивает их.
  ============================================================ }
function IsLuckyTicket(ticket: integer): boolean;
var
  leftSum, rightSum: integer;
begin
  { последние 3 цифры — «правая» половина }
  rightSum := DigitSum(ticket, true);

  { первые 3 цифры — «левая». Для этого «сдвигаем» число на 3 разряда }
  leftSum := DigitSum(ticket div 1000, false);

  IsLuckyTicket := (leftSum = rightSum);
end;

{ ============================================================
  ШАГ 3. Дисциплина: вывод оформлен отдельной процедурой.
  Никаких «простыней» в основном блоке.
  ============================================================ }
procedure Report(ticket: integer);
var
  leftSum, rightSum: integer;
begin
  leftSum  := DigitSum(ticket div 1000, false);
  rightSum := DigitSum(ticket, true);

  write(ticket:7, '  ');
  write(leftSum:3, ' + ', rightSum:3, '   ');

  if IsLuckyTicket(ticket) then
    writeln('  СЧАСТЛИВЫЙ')
  else
    writeln('  обычный');
end;

{ ============================================================
  Основная программа. Здесь — только «дирижёрская палочка»:
  никакой логики, только вызовы подпрограмм.
  ============================================================ }
const
  TICKETS: array[1..6] of integer =
    (123321, 123456, 100001, 999999, 500005, 111111);

var
  i: integer;

begin
  writeln('=== Проверка билетов на «счастливость» ===');
  writeln;
  writeln(' Билет     Суммы слева/справа   Результат');
  writeln('-------   -------------------   ------------');

  for i := 1 to 6 do
    Report(TICKETS[i]);

  writeln;
  writeln('Программа завершилась.');
end.
